/*
Updated the data model to better align with the business requirements,
with a stronger focus on billing-related use cases and analysis.
*/

IF OBJECT_ID('gold.dim_patients', 'v') IS NOT NULL
DROP VIEW gold.dim_patients;
GO

create view gold.dim_patients AS
select
    ROW_NUMBER() OVER (ORDER BY patient_id) AS patient_key, -- Surrogate Key
    patient_id,
    first_name,
    last_name,
    first_name + ' ' + last_name            AS full_name,
    gender,
    date_of_birth,
    contact_number,
    address,
    registration_date,
    insurance_provider,
    insurance_number,
    email
from silver.patients;
GO


IF OBJECT_ID('gold.dim_doctors', 'v') IS NOT NULL DROP VIEW gold.dim_doctors;

Go
create view gold.dim_doctors as
select
    ROW_NUMBER() OVER (ORDER BY doctor_id) AS doctor_key, -- Surrogate Key
    doctor_id,
    first_name,
    last_name,
    first_name + ' ' + last_name AS full_name,
    specialization,
    phone_number,
    years_experience,
    hospital_branch,
    email
from silver.doctors;
GO


IF OBJECT_ID('gold.dim_appointments', 'V') IS NOT NULL
DROP VIEW gold.dim_appointments;
GO
CREATE VIEW gold.dim_appointments AS

SELECT
	ROW_NUMBER() OVER (ORDER BY ap.appointment_id) appointment_key,
	ap.appointment_id,
	ap.doctor_id,
	ap.patient_id,
	ap.reason_for_visit,
	ap.status ,
	ap.appointment_date,
	ap.appointment_time
FROM silver.appointments ap 
Go


IF OBJECT_ID('gold.dim_treatments', 'V') IS NOT NULL
DROP VIEW gold.dim_treatments;
GO
CREATE VIEW gold.dim_treatments AS
select
	ROW_NUMBER() OVER (ORDER BY tr.treatment_id) treatment_key,
	tr.treatment_id,
	tr.appointment_id,
	tr.description,
	tr.treatment_type,
	tr.cost,
	tr.treatment_date
from silver.treatments tr
GO




IF OBJECT_ID('gold.dim_date', 'V') IS NOT NULL
    DROP VIEW gold.dim_date;
GO

CREATE VIEW gold.dim_date AS

WITH N AS
(
    SELECT TOP (DATEDIFF(DAY, '2020-01-01', '2030-12-31') + 1)
           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n
    FROM sys.all_objects a
    CROSS JOIN sys.all_objects b
),
DateSeries AS
(
    SELECT DATEADD(DAY, n, CAST('2020-01-01' AS DATE)) AS full_date
    FROM N
)
SELECT
    CAST(CONVERT(VARCHAR(8), full_date, 112) AS INT) AS date_key,

    full_date,

    YEAR(full_date) AS year,

    DATEPART(QUARTER, full_date) AS quarter,

    MONTH(full_date) AS month,

    DATENAME(MONTH, full_date) AS month_name,

    DATEPART(WEEK, full_date) AS week_of_year,

    DAY(full_date) AS day_of_month,

    DATENAME(WEEKDAY, full_date) AS day_name,

    CASE
        WHEN ((DATEDIFF(DAY, '19000101', full_date) % 7) IN (4, 5))
        THEN 1
        ELSE 0
    END AS is_weekend

FROM DateSeries;
GO



IF OBJECT_ID('gold.fact_billing', 'V') IS NOT NULL
DROP VIEW gold.fact_billing;
GO
CREATE VIEW gold.fact_billing AS

select
	ROW_NUMBER() OVER (ORDER BY bi.bill_id) billing_key,
	bi.bill_id,
	pa.patient_key,
	do.doctor_key,
	tr.treatment_key,
	ap.appointment_key,
	bi.payment_method,
	bi.payment_status,
	bi.amount,
	CAST(FORMAT(bi.bill_date, 'yyyyMMdd') AS INT) AS bill_date_key
from silver.billing bi
left join gold.dim_patients pa
on pa.patient_id=bi.patient_id
left join gold.dim_treatments tr
on tr.treatment_id=bi.treatment_id
left join gold.dim_appointments ap
on ap.appointment_id=tr.appointment_id
left join gold.dim_doctors do
on do.doctor_id=ap.doctor_id
