----------------------patients-----------------------
select patient_id,count(*)
from bronze.patients
group by patient_id
having COUNT(*)>1

select first_name
from bronze.patients
where first_name  != TRIM(first_name)
or first_name is null

select last_name
from bronze.patients
where last_name  != TRIM(last_name)
or last_name is null

select case when gender = 'F' then 'Female'
            when gender = 'M' then 'Male'
       end gender
from bronze.patients

select date_of_birth
from bronze.patients
where date_of_birth>GETDATE()

select contact_number
from bronze.patients
where contact_number != TRIM(contact_number)
or contact_number is null
or LEN(contact_number)!=10

select  address
from bronze.patients
where address != TRIM(address)

select registration_date
from bronze.patients
where registration_date>GETDATE()
or registration_date is null

select  distinct insurance_provider
from bronze.patients
where insurance_provider != TRIM(insurance_provider)

select  insurance_number
from bronze.patients
where insurance_number != TRIM(insurance_number)
or insurance_number not like 'INS%'
or LEN(insurance_number)!=9

select email
from bronze.patients
where lower (email) not like LOWER( first_name+'.'+last_name+'@mail.com')
or email is null
or email != TRIM(email)

